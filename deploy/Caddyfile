{
	admin off
	auto_https off
	servers {
		trusted_proxies static 172.30.80.4/32
		client_ip_headers CF-Connecting-IP
	}
}

:8080 {
	@public host {$PUBLIC_HOST:localhost.invalid}
	@http {
		host {$PUBLIC_HOST:localhost.invalid}
		remote_ip 172.30.80.4
		header X-Forwarded-Proto http
	}
	redir @http https://{$PUBLIC_HOST:localhost.invalid}{uri} 308
	header @public {
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-store"
		defer
	}
	reverse_proxy new-api:3000 {
		header_up X-Forwarded-For {client_ip}
		flush_interval -1
	}
	header X-Content-Type-Options nosniff
	header Referrer-Policy no-referrer
	header Link "<https://github.com/philipxyc/new-api>; rel=\"source\""
}
